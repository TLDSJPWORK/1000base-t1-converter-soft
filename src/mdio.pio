.program converter_mdio
.side_set 1
; 8 PIO cycles per MDC period. Preload all four words before enabling.
; Set the data latch before enabling its driver. Release throughout both TA bits.
; Sample at the end of LOW, before the PHY advances data on rising MDC.
.wrap_target
    out pins, 1    side 0 [1]
    out pindirs, 1 side 0
    in pins, 1     side 0
    nop            side 1 [3]
.wrap
